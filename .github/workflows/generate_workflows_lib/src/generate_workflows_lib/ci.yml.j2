# Do not edit this file.
# This file is generated automatically by executing tox -e generate-workflows

name: CI

on:
  push:
    branches:
    - 'main'
  pull_request:
  merge_group:

permissions:
  contents: read

concurrency:
  group: ${% raw %}{{ github.workflow }}-${{ github.head_ref || github.run_id }}{% endraw %}
  cancel-in-progress: true

jobs:
  misc:
    uses: ./.github/workflows/misc.yml # zizmor: ignore[self-repository] run the candidate's generated workflow
  lint:
    uses: ./.github/workflows/lint.yml # zizmor: ignore[self-repository] run the candidate's generated workflow
  {#- The test workflows share the caller name, so their checks keep the "tests / " prefix. #}
  {%- for test_workflow in test_workflows %}
  {{ test_workflow }}:
    name: tests
    uses: ./.github/workflows/{{ test_workflow }}.yml # zizmor: ignore[self-repository] run the candidate's generated workflow
  {%- endfor %}

  check:
    if: always()
    needs:
      - misc
      - lint
      {%- for test_workflow in test_workflows %}
      - {{ test_workflow }}
      {%- endfor %}
    runs-on: ubuntu-latest
    steps:
      - name: Decide whether the needed jobs succeeded or failed
        uses: re-actors/alls-green@b5b5b37504aa4183270bd3d855c52a67f212be35 # v1.3.0
        with:
          jobs: ${% raw %}{{ toJSON(needs) }}{% endraw %}
