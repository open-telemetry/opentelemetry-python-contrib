{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    extends: [
      "config:best-practices",
      "helpers:pinGitHubActionDigestsToSemver",
      ":semanticCommits"
    ],
    constraints: {
      python: "==3.10"
    },
    labels: [
      "dependencies",
      "Skip Changelog",
    ],
    lockFileMaintenance: {
      enabled: true,
      schedule: ["before 8am on Monday"],
    },
    ignorePaths: [
      ".github/renovate.json5",
      "gen-requirements.txt",
      "docs-requirements.txt",
      // pyproject.toml files are intentionally excluded: package versions are managed
      // by the release process and are not auto-updated by Renovate.
      "**/pyproject.toml",
    ],
    // pip-compile manages the oldest|latest requirements files via lockFileMaintenance (re-runs uv pip compile --resolution=lowest|highest).
    // pip_requirements is disabled for those files to avoid double-processing.
    "pip-compile": {
      managerFilePatterns: [
        "/(^|/).*-requirements[.-](oldest|latest|lowest)\.txt$/",
      ],
    },
    // Also scan GitHub Actions workflow templates written as Jinja files.
    "github-actions": {
      managerFilePatterns: [
        "/^\\.github/workflows/generate_workflows_lib/src/generate_workflows_lib/.*\\.ya?ml\\.j2$/",
      ],
    },
    packageRules: [
      {
        groupName: "all patch versions",
        matchUpdateTypes: ["patch"],
        schedule: ["before 8am every weekday"],
      },
      {
        matchUpdateTypes: ["minor", "major"],
        schedule: ["before 8am on Monday"],
      },
      {
        matchManagers: ["pip_requirements"],
        matchFileNames: [
          "**/*-requirements.oldest.txt",
          "**/*-requirements.latest.txt",
          "**/*-requirements.lowest.txt",
          "**/*-requirements-oldest.txt",
          "**/*-requirements-latest.txt",
          "**/*-requirements-lowest.txt",
        ],
        enabled: false,
      },
      {
        description: "Requirements files named oldest that carry no uv pip compile header are maintained by hand, so Renovate must not raise them to the newest release.",
        matchFileNames: [
          "instrumentation-genai/**/tests/requirements.oldest.txt",
          "resource/opentelemetry-resourcedetector-gcp/requirements.oldest.txt",
        ],
        enabled: false,
      },
      {
        groupName: "ci",
        matchManagers: [
          "github-actions",
          "dockerfile",
          "docker-compose",
        ],
        semanticCommitScope: "ci",
      },
      {
        matchDepTypes: ["uses-with"],
        matchDepNames: ["python"],
        // Disable Renovate for the python version used in GitHub Actions workflows. The version is generated based on tox envs.
        enabled: false,
      },
      {
        description: "Django test matrix slot 0 covers the 2.x series. See the slot comments above the envlist in tox.ini.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-django/test-requirements-0.txt"],
        matchPackageNames: ["django", "Django"],
        allowedVersions: "<3.0.0",
      },
      {
        description: "Django test matrix slot 1 covers the 3.x series.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-django/test-requirements-1.txt"],
        matchPackageNames: ["django", "Django"],
        allowedVersions: "<4.0.0",
      },
      {
        description: "Django test matrix slot 2 covers the 4.x series.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-django/test-requirements-2.txt"],
        matchPackageNames: ["django", "Django"],
        allowedVersions: "<5.0.0",
      },
      {
        description: "Django test matrix slot 3 covers the 5.2 series, which tox.ini documents as django>=5.2<6.0.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-django/test-requirements-3.txt"],
        matchPackageNames: ["django", "Django"],
        allowedVersions: "<6.0.0",
      },
      {
        description: "falcon test matrix slot 0 covers the 1.x series.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-falcon/test-requirements-0.txt"],
        matchPackageNames: ["falcon"],
        allowedVersions: "<2.0.0",
      },
      {
        description: "falcon test matrix slot 1 covers the 2.x series.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-falcon/test-requirements-1.txt"],
        matchPackageNames: ["falcon"],
        allowedVersions: "<3.0.0",
      },
      {
        description: "falcon test matrix slot 2 covers releases below 3.1.2.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-falcon/test-requirements-2.txt"],
        matchPackageNames: ["falcon"],
        allowedVersions: "<3.1.2",
      },
      {
        description: "falcon test matrix slot 3 covers 3.1.2 up to the 4.0 boundary.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-falcon/test-requirements-3.txt"],
        matchPackageNames: ["falcon"],
        allowedVersions: "<4.0.0",
      },
      {
        description: "falcon test matrix slot 4 covers the 4.x series, which tox.ini documents as falcon >=4.0.0,<5.0.0.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-falcon/test-requirements-4.txt"],
        matchPackageNames: ["falcon"],
        allowedVersions: "<5.0.0",
      },
      {
        description: "Flask test matrix slot 0 covers the 2.1 series.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-flask/test-requirements-0.txt"],
        matchPackageNames: ["flask", "Flask"],
        allowedVersions: "<2.2.0",
      },
      {
        description: "Flask test matrix slot 1 covers the 2.2 series.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-flask/test-requirements-1.txt"],
        matchPackageNames: ["flask", "Flask"],
        allowedVersions: "<2.3.0",
      },
      {
        description: "Flask test matrix slots 0 and 1 both pair their Flask release with Werkzeug 2.x.",
        matchFileNames: [
          "instrumentation/opentelemetry-instrumentation-flask/test-requirements-0.txt",
          "instrumentation/opentelemetry-instrumentation-flask/test-requirements-1.txt",
        ],
        matchPackageNames: ["werkzeug", "Werkzeug"],
        allowedVersions: "<3.0.0",
      },
      {
        description: "Flask test matrix slot 2 covers the 3.0 series of both Flask and Werkzeug, leaving 3.1 and newer to slot 3.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-flask/test-requirements-2.txt"],
        matchPackageNames: ["flask", "Flask", "werkzeug", "Werkzeug"],
        allowedVersions: "<3.1.0",
      },
      {
        description: "urllib3 test matrix slot 0 covers the 1.x series.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-urllib3/test-requirements-0.txt"],
        matchPackageNames: ["urllib3"],
        allowedVersions: "<2.0.0",
      },
      {
        description: "urllib3 test matrix slot 1 covers the 2.x series, which tox.ini documents as urllib3 >=2.0.0,<3.0.0.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-urllib3/test-requirements-1.txt"],
        matchPackageNames: ["urllib3"],
        allowedVersions: "<3.0.0",
      },
      {
        description: "mysql test matrix slot 0 covers the 8.x series of the connector.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-mysql/test-requirements-0.txt"],
        matchPackageNames: ["mysql-connector-python"],
        allowedVersions: "<9.0.0",
      },
      {
        description: "mysql test matrix slot 1 covers the 9.x series of the connector.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-mysql/test-requirements-1.txt"],
        matchPackageNames: ["mysql-connector-python"],
        allowedVersions: "<10.0.0",
      },
      {
        description: "pymemcache test matrix slot 0 covers the 1.x series.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-pymemcache/test-requirements-0.txt"],
        matchPackageNames: ["pymemcache"],
        allowedVersions: "<2.0.0",
      },
      {
        description: "pymemcache test matrix slot 1 covers the 2.x series.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-pymemcache/test-requirements-1.txt"],
        matchPackageNames: ["pymemcache"],
        allowedVersions: "<3.0.0",
      },
      {
        description: "pymemcache test matrix slot 2 covers releases below 3.4.2, which slot 3 pins exactly.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-pymemcache/test-requirements-2.txt"],
        matchPackageNames: ["pymemcache"],
        allowedVersions: "<3.4.2",
      },
      {
        description: "pymemcache test matrix slot 3 pins the single release 3.4.2, which tox.ini documents as pymemcache ==3.4.2 and which slot 2 stops just below.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-pymemcache/test-requirements-3.txt"],
        matchPackageNames: ["pymemcache"],
        allowedVersions: "<3.4.3",
      },
      {
        description: "grpc test matrix slot 0 covers grpcio 1.62, the oldest release the instrumentation is tested against.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-grpc/test-requirements-0.txt"],
        matchPackageNames: ["grpcio"],
        allowedVersions: "<1.63.0",
      },
      {
        description: "httpx test matrix slot 0 covers the 0.18 series together with the respx release that supports it.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-httpx/test-requirements-0.txt"],
        matchPackageNames: ["httpx"],
        allowedVersions: "<0.19.0",
      },
      {
        description: "respx 0.17 is the release that works against httpx 0.18 in test matrix slot 0.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-httpx/test-requirements-0.txt"],
        matchPackageNames: ["respx"],
        allowedVersions: "<0.18.0",
      },
      {
        description: "pika test matrix slot 0 covers the 0.x series.",
        matchFileNames: ["instrumentation/opentelemetry-instrumentation-pika/test-requirements-0.txt"],
        matchPackageNames: ["pika"],
        allowedVersions: "<1.0.0",
      },
    ],
}
