+from os import environ
+
+from opentelemetry.agent._vendor.opentelemetry.environment_variables import (
+    _AGENT_BRIDGE,
+    OTEL_PYTHON_CONTEXT,
+    OTEL_PYTHON_TRACER_PROVIDER,
+)
 from opentelemetry.agent._vendor.opentelemetry.instrumentation.auto_instrumentation import initialize
 
+# opentelemetry-agent: make the application's opentelemetry-api load the agent's bridge (entry points of
+# the opentelemetry-agent distribution), which shares the vendored API's context and tracer provider.
+# Explicitly configured implementations are kept.
+for _variable in (OTEL_PYTHON_CONTEXT, OTEL_PYTHON_TRACER_PROVIDER):
+    environ.setdefault(_variable, _AGENT_BRIDGE)
+
 initialize()
